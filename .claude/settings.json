{
  "model": "claude-sonnet-5-5",
  "enabledPlugins": {
    "claude-mem@thedotmack": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/compress-output.sh --pending",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/violation-pattern-digest.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-compact.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/sonar-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/sonar-guard-powershell.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/codegraph-gate.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/subagent-dispatch-gate.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/turn-budget-gate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tool-history-recorder.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/riper-bind.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/dict-sync-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/gate-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/strategic-compact-reminder.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/dict-blk-announce.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/output-arm-gate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/turn-budget-gate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/hot-cache-update.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/subagent-conclusion-gate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-compact.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
